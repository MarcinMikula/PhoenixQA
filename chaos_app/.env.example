# Chaos App config — Vite requires the VITE_ prefix to expose vars to the browser.
# These should mirror CHAOS_LEVEL / SHADOW_DOM_ENABLED / COMPONENT_REMOUNT_ENABLED
# in the PhoenixQA root .env so both sides (test runner + app under test)
# agree on the same run.

VITE_CHAOS_LEVEL=MEDIUM                  # LOW | MEDIUM | HIGH
VITE_SHADOW_DOM_ENABLED=false            # true | false — independent of CHAOS_LEVEL
VITE_COMPONENT_REMOUNT_ENABLED=false     # true | false — independent of CHAOS_LEVEL and Shadow DOM
                                          # Sprint 6A: only the login submit button remounts. See
                                          # chaos/componentRemount.jsx and LEARNINGS.md "Sprint 6".

# Optional — 'timeout' (default) or 'mousedown'. TIMEOUT is realistic/
# probabilistic background chaos (repeating random interval, see below).
# MOUSEDOWN is a DETERMINISTIC verification trigger: remounts the button
# synchronously the instant it receives a mousedown, isolating "what
# happens if the element is replaced exactly as an interaction begins"
# instead of depending on random timing to ever collide with a click.
# See LEARNINGS.md "Sprint 6A — deterministic MOUSEDOWN trigger".
# VITE_COMPONENT_REMOUNT_TRIGGER=mousedown

# Optional — only used when trigger=timeout (the default). Overrides the
# mechanism's realistic 200-800ms remount interval. Leave both unset for
# normal/realistic use.
# VITE_COMPONENT_REMOUNT_MIN_MS=50
# VITE_COMPONENT_REMOUNT_MAX_MS=150

# Mechanism overrides (Sprint 6A) — DEVELOPMENT/VERIFICATION USE ONLY, never
# for official Sprint 7/8 benchmark runs. Each is OPTIONAL: leave commented
# out to use whatever CHAOS_LEVEL already implies. Forces a single CORE
# mechanism (selector_rotation / dom_mutation / async_delay) on or off,
# independent of the level — e.g. to isolate DETACHED_FROM_DOM verification
# from selector_rotation's interference:
#   VITE_CHAOS_LEVEL=LOW
#   VITE_OVERRIDE_SELECTOR_ROTATION=false
#   VITE_COMPONENT_REMOUNT_ENABLED=true
#   VITE_COMPONENT_REMOUNT_TRIGGER=mousedown
# See chaos/chaosConfig.js and LEARNINGS.md "Sprint 6A — mechanism override"
# for the full reasoning (including why a "NONE" level was considered and
# rejected in favor of this more general mechanism).
# VITE_OVERRIDE_SELECTOR_ROTATION=false
# VITE_OVERRIDE_DOM_MUTATION=false
# VITE_OVERRIDE_ASYNC_DELAY=false